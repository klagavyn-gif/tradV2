# ==============================================================================
# tradV2 Environment Configuration Template (.env)
# คัดลอกไฟล์นี้ไปเป็น .env (cp .env.example .env) แล้วกรอกข้อมูลคีย์ของคุณ
# ==============================================================================

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance USDT-M Futures Auto-Trading
# ตั้งเป็น true เมื่อต้องการเปิดระบบเทรดอัตโนมัติ
BINANCE_FUTURES_AUTO_TRADE_ENABLED=false

# true = ใช้ Testnet (เงินจำลอง ปลอดภัยสำหรับทดสอบ), false = ใช้บัญชีจริง
BINANCE_FUTURES_TESTNET=true

# API Key & Secret Key จาก Binance (ดูขั้นตอนการเอาคีย์ได้ในแชท)
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ขนาดมูลค่าสัญญาต่อไม้ (Notional USDT) - 400 USDT (เมื่อใช้ Leverage 20x จะวาง Margin จริง 20 USDT)
BINANCE_FUTURES_TRADE_NOTIONAL_USDT=400.0

# จำนวนไม้ที่อนุญาตให้ถือพร้อมกันสูงสุด
BINANCE_FUTURES_MAX_POSITIONS=2

# Leverage 20x
BINANCE_FUTURES_LEVERAGE=20

# Margin Type (ISOLATED = แยกกระเป๋าความเสี่ยงรายไม้ ปลอดภัยกว่า CROSS)
BINANCE_FUTURES_MARGIN_TYPE=ISOLATED

# Dynamic Risk Management & Circuit Breaker
BINANCE_FUTURES_DYNAMIC_SIZING_ENABLED=true
BINANCE_FUTURES_EQUITY_RISK_PCT=0.40
BINANCE_FUTURES_LOSS_STREAK_THROTTLE=2
BINANCE_FUTURES_LOSS_STREAK_MAX=3
BINANCE_FUTURES_CIRCUIT_BREAKER_HOURS=6.0
BINANCE_FUTURES_DAILY_MAX_LOSS_PCT=4.0
BINANCE_FUTURES_WIN_STREAK_SCALE_ENABLE=true
